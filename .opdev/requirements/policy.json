    {
      "id": "R-policy-preview",
      "title": "Policy inspection is complete, deterministic and non-mutating",
      "statement": {
        "kind": "source",
        "source": {
          "path": "spec/engineering-policy.md",
          "sha256": "2e98c672fae6dc724b2ac52762f53c0592c9e78c31e3240d80fc2b63c7c07b80",
          "excerpt": "A pure resolver computes exact definitions, obligation membership, applicability\nconditions, boundaries, references, conflicts and a deterministic definition\nidentity. It executes no project command or network call and grants no consent."
        }
      },
      "origin": "spec/engineering-policy.md",
      "rationale": "A proposed engineering definition cannot silently drop controls, alter old policy meanings or be mistaken for qualification or migration.",
      "configurations": [
        "default"
      ],
      "criteria": [
        {
          "id": "C-policy-preview",
          "expected": "Exact supported definitions account for every historical rule, retain mandatory controls and stable meanings, reject invalid definitions and preview the actual project difference without writes or command execution."
        }
      ]
    }
  ],
