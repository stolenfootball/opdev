{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opdev.dev/schema/report-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_version", "subject", "evaluated_at", "rules", "checks", "gates"],
  "properties": {
    "schema": { "enum": [1, 2, 3] },
    "engineering": {
      "type": "object", "additionalProperties": false, "required": ["version", "minimumcd"],
      "properties": {
        "standards": {"type":"array","maxItems":16,"items":{"$ref":"#/$defs/standard_assessment"}},
        "version": { "enum": ["1", "2"] },
        "definition_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "stage": { "enum": ["local", "pre_merge", "post_merge", "package", "delivery", "recovery", "scheduled", "evaluation"] },
        "minimumcd": {
          "oneOf": [ { "type": "null" }, {
            "type": "object", "additionalProperties": false,
            "required": ["version", "source_version", "verdict", "requirements", "blocking_checks"],
            "properties": {
              "version": { "const": "1" },
              "source_version": { "const": "86665f375a3a7f5c56be22ad67f4aad20348fade" },
              "verdict": { "enum": ["passed", "blocked"] },
              "blocking_checks": { "type": "array", "items": { "type": "string" } },
              "requirements": { "type": "array", "minItems": 19, "maxItems": 19, "items": {
                "type": "object", "additionalProperties": false, "required": ["id", "outcome", "blocking_rules"],
                "properties": {
                  "id": { "type": "string" }, "outcome": { "$ref": "#/$defs/outcome" },
                  "blocking_rules": { "type": "array", "items": { "type": "string" } }
                }
              } }
            }
          } ]
        }
      }
    },
    "catalog_version": { "type": "integer", "minimum": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "integer", "minimum": 0 },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule_result" } },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check_result" } },
    "gates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/gate_result" }
    }
  },
  "allOf": [
    { "if": { "properties": { "schema": { "const": 1 } } },
      "then": { "not": { "required": ["engineering"] } } },
    { "if": { "properties": { "schema": { "const": 2 } } },
      "then": { "required": ["engineering"], "properties": {
        "catalog_version": { "const": 3 },
        "engineering": { "properties": { "version": { "const": "1" } }, "not": { "anyOf": [{"required":["definition_sha256"]},{"required":["stage"]},{"required":["standards"]}] } }
      } } },
    { "if": { "properties": { "schema": { "const": 3 } } },
      "then": { "required": ["engineering"], "properties": {
        "catalog_version": { "const": 4 },
        "engineering": { "required": ["definition_sha256", "stage"], "properties": { "version": { "const": "2" } } }
      } } }
  ],
  "$defs": {
    "standard_assessment": {
      "type":"object","additionalProperties":false,
      "required":["selection","definition_sha256","source","claim","complete_mapping","diagnostic"],
      "properties":{
        "selection":{"$ref":"#/$defs/standard_selection"},
        "definition_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "source":{"type":"object","additionalProperties":false,"required":["name","version","url"],"properties":{"name":{"type":"string"},"version":{"type":"string"},"url":{"type":"string"}}},
        "claim":{"type":"string"},"complete_mapping":{"type":"boolean"},"diagnostic":{"type":"string"},
        "assessment":{
          "type":"object","additionalProperties":false,
          "required":["version","source_version","verdict","requirements","blocking_checks"],
          "properties":{
            "version":{"type":"string"},"source_version":{"type":"string"},"verdict":{"enum":["passed","blocked"]},
            "blocking_checks":{"type":"array","items":{"type":"string"}},
            "requirements":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","outcome","blocking_rules"],"properties":{"id":{"type":"string"},"outcome":{"$ref":"#/$defs/outcome"},"blocking_rules":{"type":"array","items":{"type":"string"}}}}}
          }
        }
      },
      "if":{"properties":{"selection":{"properties":{"mode":{"const":"guidance"}}}}},
      "then":{"not":{"required":["assessment"]}}
    },
    "standard_selection": {
      "type":"object","additionalProperties":false,"required":["name","version","mode"],
      "properties":{
        "name":{"type":"string","minLength":1,"maxLength":128},"version":{"type":"string","minLength":1,"maxLength":128},
        "mode":{"enum":["guidance","assess","require"]},"level":{"type":"string","minLength":1,"maxLength":128},
        "stages":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"enum":["local","pre_merge","post_merge","package","delivery","recovery","scheduled","evaluation"]}}
      },
      "if":{"properties":{"mode":{"const":"guidance"}}},
      "then":{"properties":{"stages":{"maxItems":0}}},
      "else":{"required":["stages"],"properties":{"stages":{"minItems":1}}}
    },
    "outcome": {
      "enum": ["passed", "failed", "unverified", "not_applicable", "error", "migration_required"]
    },
    "gate": { "enum": ["development", "integration", "delivery", "compliance"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 }
      }
    },
    "rule_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "catalog_version", "outcome", "subject", "verifier", "evaluated_at", "evidence"],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+-[0-9]{3}$" },
        "catalog_version": { "type": "integer", "minimum": 1 },
        "outcome": { "$ref": "#/$defs/outcome" },
        "subject": { "type": "string", "minLength": 1 },
          "verifier": { "enum": ["catalog", "manifest", "command", "extension", "git", "ci", "evidence", "remote", "agent"] },
        "evaluated_at": { "type": "integer", "minimum": 0 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "diagnostic": { "type": "string", "minLength": 1 }
      }
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "blocking", "gates", "outcome", "summary", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["suite", "extension", "policy"] },
        "blocking": { "type": "boolean" },
        "gates": { "type": "array", "items": { "$ref": "#/$defs/gate" }, "uniqueItems": true },
        "outcome": { "$ref": "#/$defs/outcome" },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "verdict", "blocking_rules", "blocking_checks"],
      "properties": {
        "gate": { "$ref": "#/$defs/gate" },
        "verdict": { "enum": ["passed", "blocked"] },
        "blocking_rules": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+-[0-9]{3}$" },
          "uniqueItems": true
        },
        "blocking_checks": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
