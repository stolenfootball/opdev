{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opdev.dev/schema/execution-policy-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "review_reference", "inputs_complete", "environment", "executor_sha256", "producers"],
  "properties": {
    "schema": {"enum": [1,2]},
    "candidate_reuse": {
      "type":"object", "additionalProperties":false,
      "required":["review_reference","suites","commit_ref_stage_independent","source_only","maximum_age_seconds"],
      "properties":{
        "review_reference":{"type":"string","minLength":1},
        "suites":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "commit_ref_stage_independent":{"const":true}, "source_only":{"const":true},
        "maximum_age_seconds":{"type":"integer","minimum":1,"maximum":86400}
      }
    },
    "review_reference": {"type": "string", "minLength": 1},
    "inputs_complete": {"type": "boolean"},
    "ledger_is_input": {"type": "boolean", "default": true},
    "environment": {"type": "string", "minLength": 1},
    "executor_sha256": {"$ref": "#/$defs/digest"},
    "github_workflow_id": {"type": ["integer", "null"], "minimum": 1},
    "producers": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["suite", "job", "executable_sha256"],
        "properties": {
          "suite": {"type": "string", "minLength": 1},
          "job": {"type": "string", "minLength": 1},
          "executable_sha256": {"$ref": "#/$defs/digest"}
        }
      }
    }
  },
  "if":{"properties":{"schema":{"const":2}}},
  "then":{"required":["candidate_reuse"]},
  "else":{"not":{"required":["candidate_reuse"]}},
  "$defs": {"digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}
}
