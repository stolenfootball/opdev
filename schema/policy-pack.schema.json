{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opdev.dev/schema/policy-pack-v1.json",
  "title": "OpDev additive organization policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "title",
    "source",
    "controls"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "parameters": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "minimum",
              "maximum"
            ],
            "properties": {
              "kind": {
                "const": "integer"
              },
              "minimum": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "maximum": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "values"
            ],
            "properties": {
              "kind": {
                "const": "choice"
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        ]
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "source",
          "stages",
          "applicability",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ORG-[A-Z][A-Z0-9-]*-[0-9]{3}$",
            "maxLength": 72
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "enum": [
                "local",
                "pre_merge",
                "post_merge",
                "package",
                "delivery",
                "recovery",
                "scheduled",
                "evaluation"
              ]
            }
          },
          "applicability": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "always"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "all"
                  },
                  "capabilities": {
                    "type": "array",
                    "maxItems": 7,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "persistent_data",
                        "public_contract",
                        "distribution",
                        "security_boundary",
                        "operations",
                        "user_interface",
                        "effectiveness"
                      ]
                    }
                  },
                  "parameters": {
                    "type": "object",
                    "maxProperties": 16,
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    },
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "integer",
                          "minimum": -1000000,
                          "maximum": 1000000
                        },
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        }
                      ]
                    }
                  }
                }
              }
            ]
          },
          "verification": {
            "enum": [
              "automated",
              "observation"
            ]
          }
        }
      }
    }
  }
}
