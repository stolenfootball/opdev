{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opdev.dev/schema/evidence-v2.json",
  "title": "OpDev evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema"],
  "properties": {
    "schema": { "enum": [1, 2] },
    "project": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "work", "assertions"],
        "properties": {
          "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "work": { "type": "string", "minLength": 1 },
          "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
          "acceptance": { "$ref": "#/$defs/acceptance" }
        }
      }
    }
  },
  "if": { "properties": { "schema": { "const": 1 } } },
  "then": { "properties": { "changes": { "items": { "properties": {
    "acceptance": false, "assertions": { "minItems": 1 }
  } } } } },
  "$defs": {
    "work_observation": {
      "type":"object","additionalProperties":false,
      "required":["schema","selector","author_id","created_at","updated_at","body_sha256","excerpt","observed_at"],
      "properties":{
        "schema":{"const":1},"author_id":{"type":"integer","minimum":1},
        "created_at":{"type":"string","minLength":1},"updated_at":{"type":"string","minLength":1},
        "body_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "excerpt":{"type":"string","minLength":1,"maxLength":16384},"observed_at":{"type":"integer","minimum":1},
        "selector":{"type":"object","additionalProperties":false,"required":["provider","repository_id","kind","number"],"properties":{
          "provider":{"enum":["github","gitlab"]},"repository_id":{"type":"integer","minimum":1},
          "kind":{"enum":["issue","merge_request"]},"number":{"type":"integer","minimum":1},"note_id":{"type":["integer","null"],"minimum":1}
        }}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "rationale",
        "conditions",
        "verifications",
        "review"
      ],
      "properties": {
        "policy_controls": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "definition_sha256", "stage", "bindings"],
          "properties": {
            "version": {"const": "2"},
            "definition_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "stage": {"enum": ["local", "pre_merge", "post_merge", "package", "delivery", "recovery", "scheduled", "evaluation"]},
            "bindings": {
              "type": "object", "maxProperties": 4,
              "propertyNames": {"enum": ["OPDEV-FLOW-001", "OPDEV-DELIVERY-001", "OPDEV-PIPELINE-001", "OPDEV-RECOVERY-001"]},
              "additionalProperties": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "safeguards": {"type":"object","additionalProperties":false,"required":["version","impacts","objectives"],"properties":{"version":{"const":1},"impacts":{"type":"object","propertyNames":{"enum":["persistent_data","public_contract","distribution","security_boundary","operations","user_interface","effectiveness"]},"additionalProperties":{"type":"object","additionalProperties":false,"required":["impact","rationale"],"properties":{"impact":{"enum":["affected","unaffected"]},"rationale":{"type":"string","minLength":1}}}},"objectives":{"type":"object","propertyNames":{"enum":["retained_data_compatibility","data_recovery","consumer_compatibility","consumer_transition","installation_update","distribution_recovery","security_controls","operational_recovery","accessibility","effectiveness_evaluation"]},"additionalProperties":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}}},
        "requirements": {
          "type":"object", "additionalProperties":false,
          "required":["catalog_sha256","baseline_commit","baseline_catalog_sha256","rationale","decision_reference"],
          "properties":{
            "catalog_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
            "baseline_commit":{"type":"string","pattern":"^([a-f0-9]{40}|[a-f0-9]{64})$"},
            "baseline_catalog_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
            "rationale":{"type":"string","minLength":1},
            "decision_reference":{"type":"string","minLength":1},
            "manual_observations":{"type":"array","maxItems":4096,"items":{
              "type":"object","additionalProperties":false,
              "required":["plan","verification","plan_subject_sha256","observed_at","outcome","observer","observed_result","context_and_limits","reference"],
              "properties":{
                "plan":{"type":"string","minLength":1},"verification":{"type":"string","minLength":1},
                "plan_subject_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
                "observed_at":{"type":"integer","minimum":1,"maximum":9007199254740991},
                "outcome":{"enum":["passed","failed","unverified"]},
                "observer":{"type":"string","minLength":1},"observed_result":{"type":"string","minLength":1},
                "context_and_limits":{"type":"string","minLength":1},"reference":{"type":"string","minLength":1}
              }
            }}
          }
        },
        "scope": {
          "enum": [
            "behavioral",
            "non_behavioral",
            "no_material_conditions"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement",
              "authority",
              "source"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "authority": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "oneOf": [{"$ref": "#/$defs/acceptance/$defs/tracked"}, {"$ref":"#/$defs/work_observation"}]
              }
            }
          }
        },
        "verifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition",
              "method",
              "target",
              "assertion",
              "discriminating_case",
              "outcome"
            ],
            "properties": {
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "stages": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"enum": ["local", "pre_merge", "post_merge", "package", "delivery", "recovery", "scheduled", "evaluation"]}
              },
              "method": {
                "enum": [
                  "automated",
                  "review"
                ]
              },
              "target": {
                "$ref": "#/$defs/acceptance/$defs/tracked"
              },
              "assertion": {
                "type": "string",
                "minLength": 1
              },
              "discriminating_case": {
                "type": "string",
                "minLength": 1
              },
              "suite": {
                "type": "string",
                "minLength": 1
              },
              "automation_limitation": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "passed",
                  "failed",
                  "unverified"
                ]
              }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "reviewer",
            "reference",
            "rationale",
            "subject_sha256"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "passed",
                "failed",
                "unverified"
              ]
            },
            "reviewer": {
              "type": "string"
            },
            "reference": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            },
            "subject_sha256": {
              "type": "string",
              "pattern": "^([a-f0-9]{64})?$"
            }
          }
        }
      },
      "$defs": {
        "tracked": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "excerpt"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "excerpt": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "outcome", "summary", "evidence"],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+-[0-9]{3}$" },
        "outcome": { "enum": ["passed", "not_applicable"] },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "summary"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "location": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
