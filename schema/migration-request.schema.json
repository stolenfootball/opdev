{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opdev.dev/schema/migration-request-v1.json",
  "title": "Explicit coordinated project migration request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision_reference", "project", "ci_review_reference"],
  "properties": {
    "schema": {"const": 1},
    "decision_reference": {"type": "string", "minLength": 1},
    "project": {"$ref": "https://opdev.dev/schema/project.json"},
    "requirements": {"type":"object","maxProperties":1024,"propertyNames":{"pattern":"^\\.opdev/requirements/[a-z0-9_-]+\\.json$"},"additionalProperties":{"$ref":"https://opdev.dev/schema/requirements.schema.json"}},
    "ci_review_reference": {"type": "string", "minLength": 1},
    "ci": {"type": "object", "additionalProperties": {"type": "string"}},
    "clean_target": {"anyOf": [{"type":"null"}, {"$ref":"https://opdev.dev/schema/adoption.json#/properties/clean_target"}]},
    "authority_review_reference": {"type":["string","null"]},
    "cleanup": {"type":"array","maxItems":256,"items":{
      "type":"object","additionalProperties":false,"required":["path","kind","reason"],
      "properties":{"path":{"type":"string","minLength":1},"kind":{"enum":["move","retire_file","empty_directory"]},"destination":{"type":["string","null"]},"reason":{"type":"string","pattern":"\\S"}}
    }},
    "history": {"anyOf": [{"type": "null"}, {"$ref": "https://opdev.dev/schema/evidence-archive-v1.json"}]}
  }
}
