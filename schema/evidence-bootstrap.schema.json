{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opdev.dev/schema/evidence-bootstrap-v2.json",
  "title": "OpDev evidence bootstrap review",
  "description": "Compact reviewer input used to produce, but never implicitly approve, an OpDev evidence ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "change"
  ],
  "properties": {
    "schema": {
      "enum": [
        1,
        2
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "decisions"
      ],
      "properties": {
        "evidence": {
          "$ref": "#/$defs/evidence-list"
        },
        "decisions": {
          "$ref": "#/$defs/decisions"
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "work",
        "evidence",
        "decisions"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "acceptance": {
          "$ref": "#/$defs/acceptance"
        },
        "work": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidence-list"
        },
        "decisions": {
          "$ref": "#/$defs/decisions"
        }
      }
    }
  },
  "if": {
    "properties": {
      "schema": {
        "const": 1
      }
    }
  },
  "then": {
    "properties": {
      "change": {
        "properties": {
          "acceptance": false
        }
      }
    }
  },
  "$defs": {
    "acceptance": {
      "$ref": "https://opdev.dev/schema/evidence-v2.json#/$defs/acceptance"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence-list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "decisions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+-[0-9]{3}$"
      },
      "additionalProperties": {
        "enum": [
          "review_required",
          "passed",
          "not_applicable"
        ]
      }
    }
  }
}
