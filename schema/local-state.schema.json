{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opdev.dev/schema/local-state-v1.json",
  "description": "Local continuation pointers and immutable diagnostic attempt records. Never approval or reusable qualification.",
  "oneOf": [
    { "$ref": "#/$defs/context" },
    { "$ref": "#/$defs/start" },
    { "$ref": "#/$defs/completion" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "source_sha256", "configuration_sha256", "stage"],
      "properties": {
        "schema": { "const": 1 },
        "source_sha256": { "$ref": "#/$defs/digest" },
        "configuration_sha256": { "$ref": "#/$defs/digest" },
        "stage": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
      }
    },
    "reference": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "subject", "work", "references"],
      "properties": {
        "schema": { "const": 1 },
        "subject": { "$ref": "#/$defs/subject" },
        "work": { "$ref": "#/$defs/reference" },
        "references": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/reference" } }
      }
    },
    "start": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "subject", "started_at_ms", "runtime_sha256", "runtime_version", "environment", "execute_checks", "commands", "qualification", "limits"],
      "properties": {
        "schema": { "const": 1 },
        "kind": { "const": "check_attempt" },
        "subject": { "$ref": "#/$defs/subject" },
        "started_at_ms": { "type": "integer", "minimum": 0 },
        "runtime_sha256": { "$ref": "#/$defs/digest" },
        "runtime_version": { "type": "string", "minLength": 1 },
        "environment": {
          "type": "object", "additionalProperties": false, "required": ["os", "arch"],
          "properties": { "os": { "type": "string", "minLength": 1 }, "arch": { "type": "string", "minLength": 1 } }
        },
        "execute_checks": { "type": "boolean" },
        "commands": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "command_sha256"],
            "properties": { "id": { "type": "string", "minLength": 1 }, "command_sha256": { "$ref": "#/$defs/digest" } }
          }
        },
        "qualification": { "const": "unverified" },
        "limits": { "type": "string", "minLength": 1 }
      }
    },
    "completion": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "completed_at_ms", "report_sha256", "source_unchanged", "observed_subject_after", "qualification", "limits"],
      "properties": {
        "schema": { "const": 1 },
        "completed_at_ms": { "type": "integer", "minimum": 0 },
        "report_sha256": { "$ref": "#/$defs/digest" },
        "source_unchanged": { "type": "boolean" },
        "observed_subject_after": { "anyOf": [{ "$ref": "#/$defs/subject" }, { "type": "null" }] },
        "qualification": { "const": "unverified" },
        "limits": { "type": "string", "minLength": 1 }
      }
    }
  }
}
