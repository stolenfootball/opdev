{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opdev.dev/schema/test-report-inspection-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "input_sha256", "outcome", "cases", "failures", "errors", "skipped", "retry_signals", "qualification", "diagnostics"],
  "properties": {
    "schema": { "const": 1 },
    "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "outcome": { "enum": ["passed", "failed", "unverified"] },
    "cases": { "type": "integer", "minimum": 0 },
    "failures": { "type": "integer", "minimum": 0 },
    "errors": { "type": "integer", "minimum": 0 },
    "skipped": { "type": "integer", "minimum": 0 },
    "retry_signals": { "type": "integer", "minimum": 0 },
    "qualification": { "const": "unverified" },
    "diagnostics": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
