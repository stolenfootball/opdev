{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opdev.dev/schema/practical-project.json",
  "title": "OpDev practical project contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "preset", "trunk", "decision_reference", "commands", "checks"],
  "properties": {
    "schema": {"const": 5},
    "policy_version": {"const": 1},
    "preset": {"enum": ["lightweight", "standard", "assured"]},
    "trunk": {"type": "string", "pattern": "\\S"},
    "decision_reference": {"type": "string", "pattern": "\\S"},
    "commands": {
      "type": "object", "maxProperties": 256,
      "propertyNames": {"pattern": "\\S"},
      "additionalProperties": {"$ref": "#/$defs/command"}
    },
    "checks": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/check"}},
    "authorities": {
      "type": "object", "propertyNames": {"pattern": "\\S"},
      "additionalProperties": {"type": "string", "pattern": "\\S"}
    },
    "requirements": {
      "type": "array", "maxItems": 1024, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^\\.opdev/requirements/[^/\\\\:\\u0000]+\\.json$"}
    },
    "policies": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^\\.opdev/policies/[^/\\\\:\\u0000]+\\.json$"}
    }
  },
  "$defs": {
    "command": {
      "type": "object", "additionalProperties": false, "required": ["argv"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "prefixItems": [{"type": "string", "pattern": "\\S"}], "items": {"type": "string", "not": {"pattern": "\\u0000"}}},
        "working_directory": {"type": ["string", "null"]},
        "timeout_seconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 86400}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["id", "command", "stages"],
      "properties": {
        "id": {"type": "string", "pattern": "\\S"},
        "command": {"type": "string", "pattern": "\\S"},
        "stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["local", "pre_merge", "post_merge", "package", "delivery", "recovery", "scheduled", "evaluation"]}}
      }
    }
  },
  "$comment": "Runtime additionally checks unique check IDs, command links, safe contained paths and bounded regular files. Schema validation alone is not adoption or verification."
}
