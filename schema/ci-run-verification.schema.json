{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opdev.dev/schema/ci-run-verification.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "provider",
    "expected",
    "observed",
    "outcome",
    "qualification",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "enum": [1, 2]
    },
    "jobs": { "$ref": "#/$defs/jobs" },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "github",
        "gitlab"
      ]
    },
    "expected": {
      "$ref": "#/$defs/identity"
    },
    "observed": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "status",
            "conclusion",
            "attempt"
          ],
          "properties": {
            "identity": {
              "$ref": "#/$defs/identity"
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "conclusion": {
              "type": [
                "string",
                "null"
              ]
            },
            "attempt": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        }
      ]
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "unverified"
      ]
    },
    "qualification": {
      "const": "unverified"
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "if": { "properties": { "schema": { "const": 2 } } },
  "then": { "required": ["jobs"] },
  "else": { "not": { "required": ["jobs"] } },
  "$defs": {
    "job": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "status", "conclusion"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "conclusion": { "type": ["string", "null"] }
      }
    },
    "jobs": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "current", "prior", "outcome", "diagnostics"],
      "properties": {
        "required": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "current": { "type": "array", "items": { "$ref": "#/$defs/job" } },
        "prior": { "type": "array", "items": { "$ref": "#/$defs/job" } },
        "outcome": { "enum": ["passed", "failed", "unverified"] },
        "diagnostics": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "run_id",
        "reference",
        "source",
        "workflow_id"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "workflow_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}
